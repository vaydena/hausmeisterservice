# Supabase — Frontend (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Server only (never expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Produktion: https://hausmeisterservice.vaydena.de
NEXT_PUBLIC_APP_NAME=Hausmeisterservice
NODE_ENV=development

# Build-Marker für /api/health — beide OPTIONAL und normalerweise leer.
# next.config.mjs ermittelt den SHA sonst selbst per `git rev-parse HEAD`
# und setzt die Build-Zeit auf den Zeitpunkt des Builds. Nur setzen, wenn
# der Build-Host kein .git-Verzeichnis hat (dann liefert der Endpunkt
# ansonsten "unknown" als SHA) oder wenn statt des Hashes ein Release-Tag
# im Marker stehen soll. Beide Werte werden zur BUILD-Zeit eingefroren —
# nachträglich in der Hosting-Oberfläche gesetzt bleiben sie wirkungslos.
APP_BUILD_SHA=
APP_BUILD_TIME=

# Onboarding-Seed — E-Mail und Passwort des Owner-Users, der beim ersten
# `pnpm tsx supabase/seed/onboarding.ts` angelegt wird.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# E-Mail-Versand (Rechnungen/Angebote).
# Wenn RESEND_API_KEY leer bleibt, läuft der Log-Provider (schreibt in Konsole
# und in die Tabelle sent_emails, ohne echten Versand).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Optional: Antwortadresse (Reply-To). Wenn leer, wird EMAIL_FROM_ADDRESS genommen.
EMAIL_REPLY_TO=

# Automations — Cron-Endpoint /api/cron/run-automations verlangt Bearer-Token
# mit diesem Wert. Muss mindestens 16 Zeichen lang sein. In Prod z. B. bei
# Hostinger als Env-Variable + externem Cron (cron-job.org / systemd-timer).
AUTOMATION_CRON_SECRET=

# Sentry (optional) — leer lassen deaktiviert Error-Tracking komplett.
# NEXT_PUBLIC_SENTRY_DSN geht an den Browser, SENTRY_DSN bleibt Server-only.
# In Prod beide auf denselben DSN setzen, damit Client- und Server-Fehler
# ins selbe Projekt fließen. Setup-Anleitung: docs/PRODUCTION_LAUNCH.md §4.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Nur für Source-Map-Upload beim Build (CI/Prod-Deploy) — nicht in Git.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional: setzt eine Release-ID, sodass Fehler in Sentry pro Deploy
# gruppiert werden. Wenn leer, nutzt Sentry seinen eigenen Auto-Wert.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
